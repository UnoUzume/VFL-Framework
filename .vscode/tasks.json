{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: Run Current Module",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "${command:extension.commandvariable.file.relativeFileDotsNoExtension}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": [
        "$msCompile"
      ]
    }
  ]
}
